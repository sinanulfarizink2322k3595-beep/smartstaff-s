# ==============================================
# SMARTSTAFF NILGIRI - ENVIRONMENT CONFIGURATION
# ==============================================
# This is a template file. Copy this to:
# - staffhub-nextjs/backend/.env (Backend)
# - staffhub-nextjs/frontend/.env.local (Frontend)
# ==============================================

# ============================================== 
# BACKEND CONFIGURATION (staffhub-nextjs/backend/.env)
# ==============================================

# Database Connection
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartstaff"

# JWT Authentication
# Generate a secure random string (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-minimum-32-characters-long"
JWT_EXPIRES_IN="7d"

# OpenAI API (Optional - for AI Organization Builder)
# Get your key from: https://platform.openai.com/api-keys
# The system works without this (uses fallback templates)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Server Configuration
PORT=5000
NODE_ENV="development"

# ==============================================
# FRONTEND CONFIGURATION (staffhub-nextjs/frontend/.env.local)
# ==============================================

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
# 1. Copy this file to staffhub-nextjs/backend/.env
# 2. Copy this file to staffhub-nextjs/frontend/.env.local
# 3. Update DATABASE_URL with your PostgreSQL credentials
# 4. Generate a strong JWT_SECRET
# 5. (Optional) Add your OPENAI_API_KEY for AI features
# 6. Run: npm run db:migrate
# 7. Run: npm run dev
# ==============================================
